# ==============================================================================
# InternPath (InternHub) Environment Configuration
# ==============================================================================

# Supabase Project Credentials
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# Modern Supabase Publishable Key:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
# Or legacy Anon Key (backward compatible):
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (Keep private on server - ONLY for background automation tasks/workers)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# Optional: Next.js App URL for OAuth redirects and email callbacks
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Automated Crawler & Cron Secret (Protects /api/cron/collect endpoint)
# Generate a secure 32+ character string in production
CRON_SECRET=your-random-32-char-cron-secret-here
